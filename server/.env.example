# Copy this file to .env and fill it in. Never commit .env or share it.

# Your AI provider key (from console.anthropic.com). Stays on this server only.
ANTHROPIC_API_KEY=

# Model names change over time. Check docs.anthropic.com/en/docs/about-claude/models for current names.
# ANTHROPIC_MODEL is used for crop suggestions and chat; ANTHROPIC_MODEL_FAST for reminder rewrites.
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_FAST=

# One key per shop, comma-separated, as key:Shop name. Make keys with: npm run keygen
# Example: SHOP_KEYS=Xk3...long-random...:Shree Ganesh Krishi Kendra,Pq9...:Patil Agro
SHOP_KEYS=

# AI requests allowed per shop per day (controls your cost).
DAILY_LIMIT_PER_SHOP=300

# '*' allows the Windows app, Android app and web app. To restrict, list origins, e.g.
# https://app.agrimunim.in,https://localhost,null
ALLOWED_ORIGINS=*

PORT=8787
