{
  "name": "agrimunim",
  "version": "1.0.0",
  "private": true,
  "description": "AgriMunim: billing, stock, udhaar and AI crop advice for agri-input shops",
  "author": "Krishna <support +91 82752 49118>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"cross-env BUILD_TARGET=desktop vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "cross-env BUILD_TARGET=web vite build",
    "preview": "vite preview",
    "build:desktop": "cross-env BUILD_TARGET=desktop vite build && electron-builder --win --publish never",
    "android:init": "cross-env BUILD_TARGET=android vite build && cap add android && capacitor-assets generate --android",
    "build:android": "cross-env BUILD_TARGET=android vite build && cap sync android",
    "android:open": "cap open android",
    "typecheck": "tsc --noEmit",
    "server": "node server/server.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "wait-on": "^7.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "in.agrimunim.app",
    "productName": "AgriMunim",
    "copyright": "AgriMunim",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "AgriMunim-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgriMunim",
      "deleteAppDataOnUninstall": false
    }
  }
}
